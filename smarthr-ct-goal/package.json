{
  "name": "smarthr-ct-goal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:text": "node textlint/extract-ui-text.mjs && textlint textlint/ui-text.md",
    "capture": "APP_URL=${APP_URL:-http://localhost:5173} NODE_PATH=$(npm root -g) node scripts/capture.mjs states.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^10.2.2",
    "react-router-dom": "^7.18.5",
    "smarthr-ui": "^102.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-smarthr": "^14.14.0",
    "eslint-plugin-smarthr": "^6.29.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-smarthr": "^1.38.3",
    "textlint-rule-prh": "^6.1.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
