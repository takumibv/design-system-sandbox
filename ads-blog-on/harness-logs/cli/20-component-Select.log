  additionalInsideElementRefs     readonly React.RefObject<HTMLElement | null>[] | undefined
  Element refs outside the menu that should be treated as inside its light-dismiss boundary. Only used by the top-layer menu implementation.
  allowCreateWhileLoading         any
  Allow options to be created while the `isLoading` prop is true. Useful to prevent the "create new ..." option being displayed while async results are still being loaded.
  appearance                      "default" | "subtle" | "none" | undefined
  autoFocus                       boolean | undefined
